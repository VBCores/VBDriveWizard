        <file alias="spin_down_dark.svg">icons/spin_down_dark.svg</file>
        <file alias="spin_up_dark_disabled.svg">icons/spin_up_dark_disabled.svg</file>
        <file alias="spin_down_dark_disabled.svg">icons/spin_down_dark_disabled.svg</file>
        <file alias="spin_up_light.svg">icons/spin_up_light.svg</file>
        <file alias="spin_down_light.svg">icons/spin_down_light.svg</file>
        <file alias="spin_up_light_disabled.svg">icons/spin_up_light_disabled.svg</file>
        <file alias="spin_down_light_disabled.svg">icons/spin_down_light_disabled.svg</file>
